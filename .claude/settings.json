{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m simulation.checks *)",
      "Bash(python -m simulation.generate *)",
      "Bash(python analysis/scoring.py *)",
      "Bash(python analysis/oracle.py *)",
      "Bash(git pull)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.secrets/**)",
      "Read(**/credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(//c/chaves/**)",
      "Read(~/chaves/**)",
      "Edit(//c/chaves/**)",
      "Edit(~/chaves/**)",
      "Edit(/outputs/**)"
    ]
  },
  "env": {
    "PYTHONUTF8": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/sessao-abre.ps1"
            ],
            "timeout": 60,
            "statusMessage": "Lendo o estado do repositorio..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_publication.py"]
          },
          {
            "type": "command",
            "if": "Bash(git add *)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_publication.py"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.py)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/warn_py_syntax.py"]
          }
        ]
      }
    ]
  }
}
