# Segredos — nunca commitar
.env
*.key
*.pem
credentials*
.secrets/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# Build
build/
dist/

# Heavy model-run outputs (do not commit; small extracts go in runs/*/results/)
outputs/

# Derived scoring outputs (regenerable via analysis/scoring.py).
# Exclude the CONTENTS, not the directory: git will not descend into an
# excluded directory, so a negation inside one never takes effect.
analysis/out/*
!analysis/out/summary.md
!analysis/out/summary.csv
!analysis/out/diagnostics.md

# Editores / SO
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Claude Code: a infraestrutura do repo é versionada, o estado local não
# (settings.local.json continua ignorado — é por máquina, de propósito)
.claude/*
!.claude/settings.json
!.claude/commands/
!.claude/skills/
!.claude/agents/
!.claude/hooks/
.claude/settings.local.json
